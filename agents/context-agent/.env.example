# AI Context OS — local secrets template
# Copy to .env and fill values. .env is gitignored — never commit real tokens.
#
#   cp .env.example .env
#
# Load into the current shell when needed:
#   set -a && source .env && set +a
#
# For GitHub Actions publish, also set the same NPM_TOKEN as a repo secret:
#   gh secret set NPM_TOKEN
# (CI reads secrets.NPM_TOKEN, not this file.)

# --- npm publish (Automation token from https://www.npmjs.com/settings/~/tokens) ---
# Type: Automation (recommended for CI) or Publish
NPM_TOKEN=

# Used by npm CLI when publishing locally (same value as NPM_TOKEN)
NODE_AUTH_TOKEN=

# --- Optional: full A/B/C eval / semantic router embeddings ---
OPENAI_API_KEY=

# --- Optional: GitHub CLI / releases (prefer `gh auth login` over a PAT here) ---
# GITHUB_TOKEN=

{
  "version": 1,
  "suite": "design-agent-baseline",
  "rubric": {
    "dimensions": [
      {
        "id": "framing",
        "label": "Task framing",
        "weight": 10,
        "review": "Identifies the primary user, job, outcome, constraints, and consequential assumptions."
      },
      {
        "id": "hierarchy",
        "label": "Hierarchy and composition",
        "weight": 15,
        "review": "Creates a coherent reading order, clear action hierarchy, grouping, alignment, and density."
      },
      {
        "id": "behavior",
        "label": "Interaction and state completeness",
        "weight": 15,
        "review": "Defines the main flow plus applicable loading, empty, error, success, disabled, focus, and recovery behavior."
      },
      {
        "id": "accessibility",
        "label": "Accessibility",
        "weight": 15,
        "review": "Specifies semantics, keyboard and focus behavior, labels, announcements, contrast, reflow, and motion alternatives where applicable."
      },
      {
        "id": "resilience",
        "label": "Responsive and content resilience",
        "weight": 10,
        "review": "Handles narrow and wide layouts, long or localized content, zoom or text scaling, overflow, and input-method changes."
      },
      {
        "id": "system",
        "label": "Design-system coherence",
        "weight": 10,
        "review": "Uses semantic foundations and reusable component contracts without inventing unnecessary visual languages."
      },
      {
        "id": "feasibility",
        "label": "Implementation readiness",
        "weight": 10,
        "review": "Provides precise, testable behavior and acceptance criteria with realistic implementation constraints."
      },
      {
        "id": "evidence",
        "label": "Evidence and claim discipline",
        "weight": 10,
        "review": "Separates facts, assumptions, recommendations, and preferences; does not invent research, metrics, or citations."
      },
      {
        "id": "clarity",
        "label": "Clarity and precision",
        "weight": 5,
        "review": "Prioritizes important decisions, avoids vague adjectives, and makes the next action unambiguous."
      }
    ],
    "scale": {
      "0": "Absent, contradictory, or actively harmful.",
      "1": "Major gaps; unusable without substantial redesign.",
      "2": "Partial coverage with important defects.",
      "3": "Competent and usable, with identifiable omissions.",
      "4": "Strong, specific, and implementation-ready.",
      "5": "Exceptional: complete, economical, and robust under edge cases."
    },
    "global_fatal_errors": [
      "Invents user research, analytics, citations, or product facts.",
      "Contradicts an explicit task constraint.",
      "Makes the core task inaccessible with no equivalent alternative.",
      "Omits confirmation or recovery for an explicitly destructive irreversible action."
    ]
  },
  "cases": [
    {

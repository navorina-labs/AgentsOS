{
  "name": "@agentsos/safety-agent",
  "version": "0.6.0",
  "description": "Safety Agent — crypto lifecycle posture, PQC migration, and policy enforcement for AgentsOS",
  "type": "module",
  "keywords": [
    "cryptography",
    "post-quantum",
    "pqc",
    "threat-model",
    "security",
    "mosca",
    "hndl",
    "cbom"
  ],
  "bin": {
    "safety-agent": "./dist/cli/main.js",
    "safetyos": "./dist/cli/main.js",
    "sec": "./dist/cli/main.js"
  },
  "scripts": {
    "build": "tsc",
    "safety-agent": "node --import tsx src/cli/main.ts",
    "safetyos": "node --import tsx src/cli/main.ts",
    "sec": "node --import tsx src/cli/main.ts",
    "dev": "tsx src/cli/main.ts",
    "test": "node --import tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "ci": "npm run verify",
    "report": "npm run safetyos -- run --scan src --reports-dir reports"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "commander": "^13.1.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
